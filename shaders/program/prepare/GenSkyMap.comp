#define PASS_SKY_MAP

//======// Input //===============================================================================//

layout(local_size_x = 16, local_size_y = 16) in;
const ivec3 workGroups = ivec3(18, 12, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly uniform image2D skyEnvMapImg;

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"

#include "/lib/atmosphere/Common.glsl"

#include "/lib/atmosphere/clouds/Render.glsl"
#include "/lib/atmosphere/AtmosphericFog.glsl"

//======// Main //================================================================================//
void main() {
	ivec2 tid = ivec2(gl_GlobalInvocationID.xy);

	// Checkerboard render
	ivec2 offset = checkerboardOffset2x2[frameCounter & 3];
	if ((tid & 1) == offset || historyReset) {
		vec2 uv = (vec2(tid) + 0.5) * rcp(imageSize(skyEnvMapImg));

		vec3 worldDir = UnprojectCubemap(uv, 96.0);
		vec3 skyRadiance = AtmosphereSkyView(atmosphereViewPos, worldDir, sunDirWorld);

		vec2 noise = SampleStbnVec2(tid, frameCounter);

		#ifdef CLOUDS
			CloudRenderResult cloudResult = RenderClouds(worldDir, noise, skyRadiance);
            skyRadiance = skyRadiance * cloudResult.transmittance + cloudResult.scatteredLight;
		#endif

		#ifdef VOLUMETRIC_FOG
			if (isEyeInWater == 0) {
				mat2x3 volFogData = RaymarchAtmosphericFog(vec3(0.0), worldDir * lodRenderDist, noise.x, VF_MAX_SAMPLES >> 1);
				skyRadiance = ApplyFog(skyRadiance, volFogData);
			}
		#endif

		// Accumulate
		vec4 history = texelFetch(skyEnvMapTex, tid, 0);
		history.a *= float(!historyReset);

		// Adaptive accumulation to avoid long-tail ghosting:
		// - Converge quickly during the first frames (weight = 1/N)
		// - Once converged, use a fixed EMA time constant (1/32) that responds
		//   faster than the old 1/64, halving the ghost tail length
		// - If the new sample deviates strongly from history (scene change such
		//   as clouds appearing or the sun moving), boost the weight so stale
		//   history is flushed out instead of lingering as a long tail
		float count = min(++history.a, 32.0);
		float weight = rcp(count);

		float lumHist = max(dot(history.rgb, vec3(0.2126, 0.7152, 0.0722)), 1e-4);
		float lumNew  = max(dot(skyRadiance, vec3(0.2126, 0.7152, 0.0722)), 1e-4);
		float change  = abs(lumNew - lumHist) / max(lumHist, lumNew);
		weight = max(weight, change * 0.25);

		skyRadiance = mix(history.rgb, skyRadiance, weight);
		imageStore(skyEnvMapImg, tid, vec4(skyRadiance, history.a));
	}
}
